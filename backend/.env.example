# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aiscale

# JWT
JWT_ACCESS_SECRET=change-this-to-a-64-char-random-string-for-access-token
JWT_REFRESH_SECRET=change-this-to-a-64-char-random-string-for-refresh-token
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Redis (optional for local dev — falls back to in-memory)
REDIS_URL=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=xxxx
AWS_SECRET_ACCESS_KEY=xxxx
S3_BUCKET_NAME=aiscale-videos

# Email (AWS SES)
EMAIL_FROM=noreply@aiscale.in

# Sentry (optional)
SENTRY_DSN=
